# LearnWithAvisha video pipeline — copy to .env and fill in.
# .env is gitignored. Never commit real keys.

# OpenRouter — script writing, review, and Manim generation
# Model: anthropic/claude-sonnet-5 (set in video_pipeline/config.py)
OPENROUTER_API_KEY=sk-or-v1-...

# ElevenLabs — voiceover (Leandra, Eleven v3)
ELEVENLABS_API_KEY=sk_...
# Optional: skips the voice-name lookup once you know the ID
# ELEVENLABS_VOICE_ID=

# YouTube Data API v3 uses OAuth, not a key. Download the desktop-app
# OAuth client JSON from the Google Cloud console and save it as:
#   .credentials/youtube_client_secrets.json
